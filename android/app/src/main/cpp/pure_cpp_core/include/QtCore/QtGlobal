#define Q_DECLARE_FLAGS(Flags, Enum)                                                                                   \
    struct Flags                                                                                                       \
    {                                                                                                                  \
        int val;                                                                                                       \
        Flags(int v = 0)                                                                                               \
            : val(v)                                                                                                   \
        {                                                                                                              \
        }                                                                                                              \
        bool testFlag(Enum f) const                                                                                    \
        {                                                                                                              \
            return (val & f) == f;                                                                                     \
        }                                                                                                              \
        operator int() const                                                                                           \
        {                                                                                                              \
            return val;                                                                                                \
        }                                                                                                              \
    };

