#ifndef QPOINTER_H
#define QPOINTER_H

#include "QtGlobal"
#include "QObject"
#include "QSharedPointer"

template <typename T>
class QPointer {
public:
    QPointer() : m_ptr(nullptr) {}
    QPointer(T* ptr) : m_ptr(ptr) {}
    
    T* data() const { return m_ptr; }
    T* operator->() const { return m_ptr; }
    operator T*() const { return m_ptr; }
    
    bool isNull() const { return m_ptr == nullptr; }
    
private:
    T* m_ptr;
};

#endif
