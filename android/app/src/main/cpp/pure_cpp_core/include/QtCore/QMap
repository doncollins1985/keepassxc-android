#ifndef QMAP_H
#define QMAP_H

#include "QHash"
#include <map>

template <typename K, typename V>
class QMap : public QMapBase<K, V, std::map<K, V>> {
public:
    using QMapBase<K, V, std::map<K, V>>::QMapBase;
    QMap() {}
    QMap(std::initializer_list<std::pair<const K, V>> init) : QMapBase<K, V, std::map<K, V>>(init) {}
    QList<K> keys() const {
        QList<K> res;
        for (auto it = std::map<K, V>::begin(); it != std::map<K, V>::end(); ++it) res.append(it->first);
        return res;
    }
};

#endif
